# Fixes
brave-fix() {
  if _os_is_mac; then
    rm -f "$HOME/Library/Application Support/BraveSoftware/Brave-Browser/SingletonLock" \
          "$HOME/Library/Application Support/BraveSoftware/Brave-Browser/SingletonCookie"
  else
    rm -f "$HOME/.config/BraveSoftware/Brave-Browser/SingletonLock" \
          "$HOME/.config/BraveSoftware/Brave-Browser/SingletonCookie"
  fi
  echo "✅ Brave lock files removed."
}
alias fix-gpg='gpg --refresh-keys'


# ══════════════════════════════════════════════════════════════════════════════
# 2. SERVICES 🐳  (Multi-Platform: Linux · macOS · WSL)
# ══════════════════════════════════════════════════════════════════════════════

# Internal helper — wraps systemctl / brew services / net.exe depending on OS
_svc() {
  local action="$1" service="$2"
  if _os_is_mac; then
    case "$action" in
      start|stop|restart) brew services "$action" "$service" ;;
      status)             brew services info "$service" ;;
    esac
  elif _os_is_wsl; then
    if systemctl is-system-running >/dev/null 2>&1; then
      sudo systemctl "$action" "$service"
    else
      case "$action" in
        start)   net.exe start "$service" 2>/dev/null || echo "⚠️  Start '$service' manually." ;;
        stop)    net.exe stop  "$service" 2>/dev/null || echo "⚠️  Stop '$service' manually." ;;
        restart) net.exe stop "$service" 2>/dev/null; net.exe start "$service" 2>/dev/null ;;
        status)  sc.exe query "$service" 2>/dev/null ;;
      esac
    fi
  else
    sudo systemctl "$action" "$service"
  fi
}

# PostgreSQL
pg-start()   { echo "🐘 Starting PostgreSQL...";  _svc start postgresql   && echo "✅ PostgreSQL started"; }
pg-stop()    { echo "🐘 Stopping PostgreSQL...";  _svc stop  postgresql   && echo "✅ PostgreSQL stopped"; }
pg-status()  { echo "🐘 PostgreSQL status:";       _svc status postgresql; }
pg-restart() { echo "🐘 Restarting PostgreSQL..."; _svc restart postgresql && echo "✅ PostgreSQL restarted"; }
pg-log() {
  if _os_is_mac; then
    tail -f /opt/homebrew/var/log/postgresql*.log 2>/dev/null || \
    tail -f /usr/local/var/log/postgresql*.log 2>/dev/null || \
    echo "⚠️  PostgreSQL log not found. Try: brew info postgresql"
  else
    echo "🐘 Following PostgreSQL logs (Ctrl+C to exit)..."
    sudo journalctl -u postgresql -f
  fi
}
start-sql() { pg-start; }
stop-sql()  { pg-stop; }

# MySQL
my-start()  { echo "🐬 Starting MySQL..."; _svc start  mysql && echo "✅ MySQL started"; }
my-stop()   { echo "🐬 Stopping MySQL..."; _svc stop   mysql && echo "✅ MySQL stopped"; }
my-status() { echo "🐬 MySQL status:";     _svc status mysql; }

# MongoDB
mg-start()  { echo "🍃 Starting MongoDB..."; _svc start  mongod && echo "✅ MongoDB started"; }
mg-stop()   { echo "🍃 Stopping MongoDB..."; _svc stop   mongod && echo "✅ MongoDB stopped"; }
mg-status() { echo "🍃 MongoDB status:";     _svc status mongod; }

# Redis
re-start()  { echo "🔴 Starting Redis..."; _svc start  redis-server && echo "✅ Redis started"; }
re-stop()   { echo "🔴 Stopping Redis..."; _svc stop   redis-server && echo "✅ Redis stopped"; }
alias re-cli='echo "🔴 Connecting to Redis CLI..." && redis-cli'
alias re-flush='echo "⚠️  Flushing all Redis data..." && redis-cli FLUSHALL && echo "🔴 Redis cleared"'

# Docker
dk-start()  { echo "🐳 Starting Docker..."; _svc start  docker && echo "✅ Docker started"; }
dk-stop()   { echo "🐳 Stopping Docker..."; _svc stop   docker && echo "✅ Docker stopped"; }
dk-status() { echo "🐳 Docker status:";     _svc status docker; }

# Combos
alias dev-up='echo "▶ Starting dev stack..." && pg-start && dk-start && re-start && echo "✅ Dev stack started"'
alias dev-down='echo "■ Stopping dev stack..." && pg-stop && mg-stop && dk-stop && re-stop && echo "🛑 Dev stack stopped"'
dev-break() {
  dev-down && clean-sys
  if _os_is_mac; then sudo shutdown -h now; else sudo shutdown now; fi
}

# Ports (cross-platform: fuser on Linux, lsof on macOS, taskkill on WSL)
kill-port() {
  local port="${1:?🔌 Usage: kill-port <port>}"
  echo "🔌 Killing port $port..."
  if _os_is_mac; then
    lsof -ti:"$port" | xargs kill -9 2>/dev/null && echo "✅ Port $port freed" || echo "⚠️ Nothing on port $port"
  elif _os_is_wsl; then
    command -v fuser >/dev/null 2>&1 \
      && fuser -k "${port}/tcp" && echo "✅ Port $port freed" \
      || netstat.exe -ano | grep ":$port " | awk '{print $5}' | xargs -I{} taskkill.exe /PID {} /F 2>/dev/null
  else
    fuser -k "${port}/tcp" 2>/dev/null && echo "✅ Port $port freed" || echo "⚠️ Nothing on port $port"
  fi
}
alias kill3000='kill-port 3000'
alias kill4200='kill-port 4200'
alias kill8080='kill-port 8080'


# ══════════════════════════════════════════════════════════════════════════════
# 📋 CLIPBOARD HISTORY (Multi-Platform: Wayland · X11 · macOS · WSL)
# ══════════════════════════════════════════════════════════════════════════════
# Functions moved to scripts/zsh_functions.zsh
_clipboard_paste() {
  if _os_is_mac; then
    pbpaste
  elif _os_is_wsl; then
    powershell.exe Get-Clipboard 2>/dev/null | tr -d '\r'
  elif [[ -n "$WAYLAND_DISPLAY" ]]; then
    wl-paste 2>/dev/null
  elif [[ -n "$DISPLAY" ]]; then
    xclip -selection clipboard -o 2>/dev/null || xsel -bo 2>/dev/null
  else
    echo "❌ No clipboard backend detected"
  fi
}
alias clip='echo "📋 Current clipboard:" && _clipboard_paste'
alias clip-clear='rm -f "$HOME/.cache/clipboard_history.log" && echo "🗑️  Clipboard history cleared."'

