# 4. AI & LLM 🤖
# ══════════════════════════════════════════════════════════════════════════════
alias gpt='codex --ask-for-approval never --sandbox danger-full-access'
# Locate migrate_skills.py — dynamic resolution, works on any OS/user.
# Priority: 1) $THR_SKILL_SCRIPT env var  2) stable install locations  3) auto-discover
_find_migrate_script() {
  # 1. Explicit override via env var (set in ~/.zsh_local for custom paths)
  [[ -n "$THR_SKILL_SCRIPT" && -f "$THR_SKILL_SCRIPT" ]] && echo "$THR_SKILL_SCRIPT" && return
  # 2. Stable/known locations (all resolved via $HOME — portable across users & OS)
  local _candidates=(
    "$HOME/.local/share/thr-skill/scripts/migrate_skills.py"   # installed by dotfiles install.sh
    "$HOME/.agents/scripts/migrate_skills.py"
    "$HOME/dotfiles/scripts/migrate_skills.py"
    "$HOME/Downloads/thr-skill/scripts/migrate_skills.py"
    "$HOME/.gemini/antigravity-cli/scripts/migrate_skills.py"
    "$HOME/.claude/scripts/migrate_skills.py"
  )
  for _f in "${_candidates[@]}"; do
    [[ -f "$_f" ]] && echo "$_f" && return
  done
  # 3. Auto-discover anywhere under $HOME (depth 6)
  local _found
  _found=$(find "$HOME" -maxdepth 6 -name "migrate_skills.py" 2>/dev/null | head -1)
  [[ -n "$_found" ]] && echo "$_found" && return
  echo "migrate_skills.py"  # last resort: hope it's on PATH
}

skill-list() {
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "\n💡 SKILL-LIST USAGE:"
    echo "   $ skill-list                   # List skills in ALL CLI agents"
    echo "   $ skill-list --from claude     # List skills from Claude Code CLI only"
    echo "   $ skill-list --from antigravity# List skills from Antigravity CLI only"
    echo "   $ skill-list --from agents     # List skills from OpenAI Codex / Agents only"
    echo "   $ skill-list --from download   # List archives in Downloads/thr-skill only\n"
    return 0
  fi
  local _py
  _py="$(_find_python)"
  [[ -z "$_py" ]] && echo "❌ Python not found. Please install Python 3." && return 1
  "$_py" "$(_find_migrate_script)" list "$@"
}

skill-migrate() {
  if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    echo "\n⚠️  Bad combination or missing arguments for 'skill-migrate'!"
    echo "💡 RECOMMENDED USAGE:"
    echo "   $ skill-migrate <skill-name> --from <source> --to <destination> [--mode symlink|copy|pack|unpack]"
    echo "   Example: skill-migrate thr-cyber --from antigravity --to claude,agents\n"
    return 1
  fi
  local _py
  _py="$(_find_python)"
  [[ -z "$_py" ]] && echo "❌ Python not found. Please install Python 3." && return 1
  "$_py" "$(_find_migrate_script)" migrate "$@"
}

skill-sync() {
  local _py
  _py="$(_find_python)"
  [[ -z "$_py" ]] && echo "❌ Python not found. Please install Python 3." && return 1
  "$_py" "$(_find_migrate_script)" sync-all "$@"
}


