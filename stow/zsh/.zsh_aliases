# ══════════════════════════════════════════════════════════════════════════════
# OS DETECTION HELPERS 🖥️  (Linux · macOS · WSL · Windows)
# ══════════════════════════════════════════════════════════════════════════════
_os_is_mac()   { [[ "$OSTYPE" == darwin* ]]; }
_os_is_linux() { [[ "$OSTYPE" == linux-gnu* ]]; }
_os_is_wsl()   { [[ -f /proc/version ]] && grep -qi microsoft /proc/version 2>/dev/null; }

# Find Python executable — python3 (Linux/macOS), py (Windows/some envs)
_find_python() {
  if   command -v python3 >/dev/null 2>&1; then echo "python3"
  elif command -v python  >/dev/null 2>&1; then echo "python"
  elif command -v py      >/dev/null 2>&1; then echo "py"     # Windows
  else echo ""; fi
}


